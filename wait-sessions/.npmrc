; Refuse to install package versions published less than 7 days ago, to reduce
; exposure to compromised releases. The value is a number of days, and the
; config requires npm >= 11.10.0 (see engines/packageManager).
min-release-age=7

; Fail the install if the active node/npm doesn't satisfy "engines" in package.json.
engine-strict=true
ignore-scripts=true
